{
  "name": "yang-static-blog",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/prune-export.mjs && node scripts/validate-export.mjs",
    "start": "next dev",
    "test": "npm run check",
    "lint": "eslint app next.config.ts postcss.config.mjs",
    "check:content": "node scripts/validate-content.mjs",
    "optimize:images": "node scripts/optimize-images.mjs",
    "check": "npm run lint && npm run check:content && npm run build"
  },
  "dependencies": {
    "github-slugger": "^2.0.0",
    "katex": "^0.18.1",
    "mdast-util-to-string": "^4.0.0",
    "next": "^16.3.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-react": "^8.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.3.1",
    "prettier": "^3.9.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "type": "module"
}
